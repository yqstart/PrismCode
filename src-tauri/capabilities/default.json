{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for Prism Code windows",
  "windows": ["main", "proj-*"],
  "permissions": [
    "core:default",
    "core:window:allow-create",
    "core:window:allow-set-title",
    "core:window:allow-set-theme",
    "core:window:allow-start-dragging",
    "core:app:allow-set-app-theme",
    "core:webview:allow-create-webview-window",
    "opener:default",
    "dialog:default",
    "fs:default",
    "fs:allow-watch",
    "fs:allow-unwatch",
    "fs:scope-home-recursive",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$HOME/**" },
        { "path": "/Volumes/**" },
        { "path": "/tmp/**" },
        { "path": "/private/tmp/**" }
      ]
    },
    "pty:default",
    "updater:default",
    "process:default"
  ]
}
