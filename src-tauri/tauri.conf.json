{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Prism Code",
  "version": "3.2.0",
  "identifier": "com.prismcode.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Prism Code",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 720,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/**",
          "/Volumes/**",
          "/tmp/**",
          "/private/tmp/**",
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "publisher": "Prism Code",
    "macOS": {
      "signingIdentity": "-"
    },
    "resources": [
      "../LICENSE",
      "../THIRD-PARTY-NOTICES.md"
    ],
    "fileAssociations": [
      {
        "ext": [
          "js",
          "jsx",
          "mjs",
          "cjs",
          "ts",
          "tsx",
          "mts",
          "cts",
          "vue",
          "html",
          "htm",
          "css",
          "scss",
          "sass",
          "less",
          "json",
          "md",
          "markdown",
          "yaml",
          "yml",
          "xml",
          "svg"
        ],
        "name": "Prism Code Source File",
        "role": "Editor",
        "rank": "Alternate"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "fs": {
      "requireLiteralLeadingDot": false
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYxODg2OUNGRUJGRTIwRjMKUldUeklQN3J6Mm1JOFZGejc5cUpQbzlGbnp4dVBCTEZuMk9FelNXU2xjSVhuUHBValdlM3ZLamMK",
      "endpoints": [
        "https://github.com/yqstart/PrismCode/releases/latest/download/latest.json",
        "https://ghfast.top/https://github.com/yqstart/PrismCode/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
